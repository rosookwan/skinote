# 스키노트 서버 설정(/etc/skinote/skinote.env). 비밀값은 여기에 두지 않는다.
# deploy.sh가 이 파일이 없을 때만 한 번 만든다(첫 매장 id를 새로 만들어 넣음). 그 뒤에는 손으로 고치고
#   sudo systemctl restart skinote-server
# 파일 권한: root:skinote 0640

# 자료 폴더: db/control.sqlite, db/shops/<매장 id>.sqlite, backups/<날짜>/
SKINOTE_DATA_DIR=/var/lib/skinote

# 앞단(Caddy)만 붙는다. 포트를 바꾸면 /etc/caddy/sites/skinote.caddy와 deploy.sh의 확인도 함께 바꾼다.
SKINOTE_HOST=127.0.0.1
SKINOTE_PORT=3100

# 쉼표로 나눈 매장 id(영문 · 숫자 · '-' · '_', 1~64자). 새 id: node /srv/skinote/current/server/bin/new-shop-id.js
SKINOTE_SHOP_IDS=01EXAMPLE0000000000000000

# 매장 시간대와 하루 기준 시각(이보다 이른 시각은 전날 영업일, data-model 3-3)
SKINOTE_TZ=Asia/Seoul
SKINOTE_CUTOFF=06:00

# 날마다 백업 폴더를 몇 개 남길지
SKINOTE_BACKUP_KEEP_DAYS=14

# 백업 뒤에도 디스크에 남겨 둘 여유(MB). 여러 앱이 나눠 쓰는 디스크라 이보다 모자라면 백업이 쓰지 않고 실패한다(알림).
# /api/health의 DISK_LOW 경고도 이 값(또는 80%)을 기준으로 한다.
SKINOTE_BACKUP_RESERVE_MB=2048

# 판 이름은 배포가 릴리스의 server/RELEASE에 적는다. 여기서 정하면 그 값이 이긴다(보통 비워 둔다).
# SKINOTE_RELEASE=
