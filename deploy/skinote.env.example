# 스키노트 서버 설정(/etc/skinote/skinote.env). 비밀값은 여기에 두지 않는다(/etc/skinote/secrets.env, 배포가 만든다).
# deploy.sh가 이 파일이 없을 때만 한 번 만든다(첫 매장 id를 새로 만들어 넣음). 그 뒤에는 손으로 고치고
#   sudo systemctl restart skinote-server
# 파일 권한: root:skinote 0640

# 자료 폴더: db/control.sqlite, db/shops/<매장 id>.sqlite, backups/<날짜>/
SKINOTE_DATA_DIR=/var/lib/skinote

# 앞단(Caddy)만 붙는다. 포트를 바꾸면 /etc/caddy/sites/skinote.caddy와 deploy.sh의 확인도 함께 바꾼다.
SKINOTE_HOST=127.0.0.1
SKINOTE_PORT=3100

# 앱 주소(https://호스트, 경로 · 끝 빗금 없음). Origin 확인과 기기 서명 문장에 쓴다. 운영(NODE_ENV=production)에서 API를 켜면 꼭 있어야
# 한다. 배포가 SKINOTE_SITE로 채우고, 사이트 주소가 바뀌면 따라 고친다(이 줄은 예시 주소).
SKINOTE_PUBLIC_ORIGIN=https://skinote.example.invalid

# 장부 API(on 기본 · off는 상태 확인만 하는 비상용). on이면 /etc/skinote/secrets.env의 비밀값 넷이 있어야 한다.
SKINOTE_API=on

# 시험 매장의 열린 기기 등록(off 기본 · on). on이고 서버의 매장이 시험 매장(provision --test) 하나일 때만 새 기기가 등록 번호 없이
# 종류(카운터 · 기사 휴대폰 · 기사 태블릿)와 기사 기기의 차량을 골라 스스로 등록한다(`시험 기기 N`). 직원 비밀번호 로그인 · 다섯 번
# 잠금 · 기기 끊기는 그대로다(잠금 셈은 스스로 붙은 기기 모두가 한 기기). 켜져 있는 동안 서버 안의 /api/health와 deploy.sh --status에
# 경고가 뜬다. 배포(설치)는 이 줄을 바꾸지 않는다. 켜고 끄기: deploy/deploy.sh --set-env SKINOTE_TEST_OPEN_ENROLL=on 또는 =off(서버를 다시
# 켠다). on은 마지막 영업일 SKINOTE_TEST_OPEN_ENROLL_UNTIL=YYYY-MM-DD(오늘 + 7일, 길어도 14일)를 함께 적고 그날이 지나면 저절로 꺼진다.
# 끄면(기한이 지나도) 스스로 붙은 기기는 모두 끊긴다(다시 쓰려면 등록 번호). 켜 둔 동안 앱 주소를 아는 누구나 모든 직원 이름을 보므로
# 시험 매장의 직원은 시험용 이름이나 이름만, 비밀번호 6자리, 차량은 'N호 차량'으로(deploy/README 9-2). 실제 손님 자료 전에 off.
SKINOTE_TEST_OPEN_ENROLL=off

# 쉼표로 나눈 매장 id(영문 · 숫자 · '-' · '_', 1~64자). 새 id: node /srv/skinote/current/server/bin/new-shop-id.js
SKINOTE_SHOP_IDS=01EXAMPLE0000000000000000

# 매장 시간대와 하루 기준 시각(이보다 이른 시각은 전날 영업일, data-model 3-3)
SKINOTE_TZ=Asia/Seoul
SKINOTE_CUTOFF=06:00

# 날마다 백업 폴더를 몇 개 남길지
SKINOTE_BACKUP_KEEP_DAYS=14

# 백업 뒤에도 디스크에 남겨 둘 여유(MB). 여러 앱이 나눠 쓰는 디스크라 이보다 모자라면 백업이 쓰지 않고 실패한다(알림).
# /api/health의 DISK_LOW 경고도 이 값(또는 80%)을 기준으로 한다.
SKINOTE_BACKUP_RESERVE_MB=2048

# 판 이름은 배포가 릴리스의 server/RELEASE에 적는다. 여기서 정하면 그 값이 이긴다(보통 비워 둔다).
# SKINOTE_RELEASE=
