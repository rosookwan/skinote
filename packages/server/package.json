{
  "name": "@skinote/server",
  "version": "0.1.0",
  "private": true,
  "description": "스키노트 중앙 서버의 뼈대: 시작할 때 control · 매장 파일 마이그레이션, 상태 확인(/api/health), 날마다 백업. 의존성 없이 Node 내장 모듈과 @skinote/schema만 쓴다.",
  "type": "module",
  "main": "src/main.js",
  "exports": {
    "./config": "./src/config.js",
    "./backup": "./src/backup.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@skinote/schema": "0.1.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "backup": "node --disable-warning=ExperimentalWarning bin/backup.js"
  }
}
